# ==============================================================================
# MetroMind Environment Variables Template (.env.example)
# Rename this file to .env for local Docker Compose execution.
# DO NOT commit production credentials or secret keys to version control.
# ==============================================================================

# Database Passwords & Usernames
ORACLE_SYSTEM_PASSWORD=admin
ORACLE_USER=system
ORACLE_PASSWORD=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# Security & Authentication Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971
GATEWAY_INTERNAL_SECRET=local-dev-secret-change-me

# Service Discovery (Eureka)
EUREKA_USER=eureka
EUREKA_PASSWORD=eureka123

# Inter-Service URLs (Docker Resolvable)
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
API_GATEWAY_URL=http://api-gateway:8080
FORECAST_SERVICE_URL=http://forecast-service:8002
SCHEDULE_SERVICE_URL=http://schedule-service:8086
FLEET_SERVICE_URL=http://fleet-service:8085
MAINTENANCE_SERVICE_URL=http://maintenance-service:8084
APPROVER_SERVICE_URL=http://approver-service:8088
